{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "cross-env NG_BUILD_SASS_EMBEDDED=0 ng serve",
    "build": "cross-env NG_BUILD_SASS_EMBEDDED=0 ng build",
    "build:gh": "cross-env NG_BUILD_SASS_EMBEDDED=0 ng build --base-href /portfolio/",
    "deploy": "npm run build:gh && gh-pages -d dist/angular-portfolio/browser",
    "watch": "cross-env NG_BUILD_SASS_EMBEDDED=0 ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:AngularPortfolio": "node dist/angular-portfolio/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "express": "^4.22.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/express": "^4.17.25",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
